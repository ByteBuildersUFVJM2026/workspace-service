# Copie este arquivo para .env e preencha os valores conforme o ambiente.
# Nunca commite o arquivo .env real.

# Perfil Spring
SPRING_PROFILES_ACTIVE=dev

# Usuario administrador inicial
ADMIN_EMAIL=admin@liga.local
ADMIN_PASSWORD=<defina_uma_senha_forte>

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ligadb
DB_USERNAME=postgres
DB_PASSWORD=<senha_admin_do_postgres>

# Usuario da aplicacao usado pelo Flyway/app
USER_APP=app_user
PASSWORD_APP=<senha_do_usuario_da_aplicacao>

# JWT
JWT_SECRET=<segredo_longo_aleatorio_com_no_minimo_256_bits>
JWT_ISSUER=academic-project-api
JWT_EXPIRATION_SECONDS=7200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<senha_do_redis>

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<minio_access_key>
MINIO_SECRET_KEY=<minio_secret_key>
MINIO_BUCKET=academic-project-files

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Proxy / load balancer
TRUST_FORWARDED_HEADERS=false
